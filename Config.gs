/**
 * المديريات الستون + أسماء الدخول وكلمات المرور الأولية:
 *   أدرار: de01 / Educ01      الجزائر شرق: dee16 / Educe16
 *   الجزائر وسط: dec16 / Educc16      الجزائر غرب: deo16 / Educo16
 */
function directorates_() {
  const out = [];
  WILAYAS.forEach(function (w) {
    if (w[0] === '16') {
      ALGIERS.forEach(function (a) {
        out.push({ code: a.code, name: a.name, username: 'de' + a.tag + '16', password: 'Educ' + a.tag + '16' });
      });
    } else {
      out.push({ code: w[0], name: w[1], username: 'de' + w[0], password: 'Educ' + w[0] });
    }
  });
  return out;
}

