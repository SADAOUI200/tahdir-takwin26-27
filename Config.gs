const ALGIERS = [
  { code: '16E', name: 'الجزائر شرق', tag: 'e' },
  { code: '16C', name: 'الجزائر وسط', tag: 'c' },
  { code: '16W', name: 'الجزائر غرب', tag: 'o' }
